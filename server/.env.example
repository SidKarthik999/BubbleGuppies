# Copy to server/.env and fill in. server/.env is git-ignored; never commit a real key.

# Required for /api/analyze. Use the NOVA-issued OpenRouter key for app requests only.
OPENROUTER_API_KEY=your-openrouter-key-here

# Optional. Must support structured outputs on OpenRouter. Default: google/gemini-3.8-flash
# OPENROUTER_MODEL=google/gemini-3.8-flash

# Optional. Upstream timeout in milliseconds. Default: 30000
# OPENROUTER_TIMEOUT_MS=30000

# Optional. API port on 127.0.0.1. Default: 8787 (the Vite proxy expects 8787)
# PORT=8787
