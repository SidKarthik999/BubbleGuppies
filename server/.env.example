# Copy to server/.env and fill in. server/.env is git-ignored; never commit a real key.

# Required for /api/analyze, /api/ink/transcribe, and /api/assist.
# Use the NOVA-issued OpenRouter key for app requests only.
OPENROUTER_API_KEY=your-openrouter-key-here

# Optional. Must support structured outputs on OpenRouter. Default: google/gemini-3.8-flash
# OPENROUTER_MODEL=google/gemini-3.8-flash

# Optional. Vision model for /api/ink/transcribe (image input + structured outputs).
# Default: same as OPENROUTER_MODEL. google/gemini-3.8-flash accepts images.
# OPENROUTER_VISION_MODEL=google/gemini-3.8-flash

# Optional. Reasoning effort sent to the model: minimal, low, medium, high, or off.
# Default: low. gemini-3.8-flash cannot disable reasoning and does not accept "minimal".
# "off" omits the parameter (use it for models without reasoning support).
# OPENROUTER_REASONING_EFFORT=low

# Optional. Upstream timeouts in milliseconds. Defaults: analyze/assist 12000, transcribe 8000.
# OPENROUTER_TIMEOUT_MS=12000
# OPENROUTER_VISION_TIMEOUT_MS=8000

# Optional. Total time budget for a request that uses the web fallback. Default: 20000
# OPENROUTER_WEB_BUDGET_MS=20000

# Optional. Upstream base URL; tests point this at a local stub. Default: https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional. API port on 127.0.0.1. Default: 8787 (the Vite proxy expects 8787)
# PORT=8787

# Sketches (anatomy-live, POST /api/draw). Default: Claude Opus 5.5 in fast
# mode, i.e. OpenRouter's "anthropic/fast" endpoint (about 2x Opus pricing).
# ANATOMY_LIVE_MODEL=anthropic/claude-opus-5.5
# Leave empty to use anatomy-live's own latency-sorted routing (standard speed).
# ANATOMY_LIVE_PROVIDER=anthropic/fast
